{
  "name": "Mini-Projeto-Rag",

  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile"
  },

  "containerUser": "root",
  "remoteUser": "root",

  "postCreateCommand": "pip install -r requirements-dev.txt",

  "forwardPorts": [8000],

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },

  "workspaceMount" : "source=${localWorkspaceFolder},target=/app,type=bind",
  "workspaceFolder": "/app"

}
